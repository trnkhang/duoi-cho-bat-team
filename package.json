    "react-router-dom": "5.3.3"
  },
  "devDependencies": {
    "@types/jest": "27.4.1",
    "@types/react": "18.3.9",
    "@types/react-dom": "18.3.0",
    "@types/react-router-dom": "5.3.3",
    "@zpi/micro-app-cli": "1.0.6",
    "eslint": "^8.57.0",
    "sass": "1.77.8",
